    {
      "parameters": {
        "jsCode": "const weather = $input.first().json;\n\nconst dates = weather.daily.time;\nconst maxTemps = weather.daily.temperature_2m_max;\nconst minTemps = weather.daily.temperature_2m_min;\nconst rainfall = weather.daily.precipitation_sum;\n\nreturn dates.map((date, index) => {\n  const max = maxTemps[index];\n  const min = minTemps[index];\n  const rain = rainfall[index];\n\n  let status = \"Normal\";\n\n  if (max >= 40) {\n    status = \"Extreme Heat\";\n  } else if (min <= 0) {\n    status = \"Extreme Cold\";\n  } else if (rain >= 30) {\n    status = \"Heavy Rain\";\n  }\n\n  return {\n    json: {\n      date: date,\n      city: \"Islamabad\",\n      max_temperature: max,\n      min_temperature: min,\n      precipitation: rain,\n      weather_status: status\n    }\n  };\n});"
      },
