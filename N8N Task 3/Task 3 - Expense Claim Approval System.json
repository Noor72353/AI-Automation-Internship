    {
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3.6-flash",
          "mode": "list",
          "cachedResultName": "Gemini 3.6 Flash"
        },
        "text": "Analyze the uploaded expense receipt carefully.\n\nFirst, determine whether the receipt is readable enough to reliably extract its important information.\n\nReturn JSON only, using exactly these fields:\n\n{\n  \"receipt_readability\": \"Readable or Unreadable\",\n  \"merchant_name\": null,\n  \"receipt_date\": null,\n  \"receipt_number\": null,\n  \"total_amount\": null,\n  \"currency\": null,\n  \"tax_amount\": null,\n  \"expense_category\": null\n}\n\nRules:\n\n1. Set receipt_readability to \"Readable\" only if the receipt is clear enough to identify its important details reliably.\n2. Set receipt_readability to \"Unreadable\" if the receipt is blurry, distorted, obscured, or its important details cannot be read confidently.\n3. Never guess or invent receipt information.\n4. If a field cannot be read confidently, return null for that field.\n5. If the receipt is unreadable, return null for all receipt detail fields.\n6. Extract the actual total amount, not a subtotal.\n7. Return valid JSON only. Do not include Markdown or explanations.",
        "inputType": "binary",
        "binaryPropertyName": "Receipt_Upload",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        224,
        0
      ],
      "id": "6cbd5765-d063-4b55-b513-c5913499c2c6",
      "name": "Analyze an image",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "googlePalmApi": {
          "id": "mG2Ryo5HWiaAlBVG",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const response = item.json.content.parts[0].text;\n\n  // Remove Markdown code fences\n  const cleaned = response\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  // Convert Gemini response into a JavaScript object\n  const expense = JSON.parse(cleaned);\n\n  return {\n    json: {\n      merchant_name: expense.merchant_name ?? null,\n      receipt_date: expense.receipt_date ?? null,\n      receipt_number: expense.receipt_number ?? null,\n      total_amount:\n        expense.total_amount === null ||\n        expense.total_amount === undefined ||\n        expense.total_amount === ''\n          ? null\n          : Number(expense.total_amount),\n      currency: expense.currency ?? null,\n      tax_amount: expense.tax_amount ?? null,\n      expense_category: expense.expense_category ?? null,\n      receipt_readability: expense.receipt_readability ?? \"Unreadable\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "45858ff1-348b-461e-9900-53cc45faf616",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        688,
        16
      ],
      "id": "9b58f6d3-9e40-4f38-8bc5-97af881b944f",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  const errors = [];\n  if (data.receipt_readability !== \"Readable\") {\n  errors.push(\"Receipt is unreadable or could not be verified\");\n}\n\n  // Check employee information\n  if (!data[\"Employee Name\"]) {\n    errors.push(\"Employee name is missing\");\n  }\n\n  if (\n    !data[\"Employee Email\"] ||\n    !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(data[\"Employee Email\"])\n  ) {\n    errors.push(\"Employee email is missing or invalid\");\n  }\n\n  // Check expense description\n  if (\n    !data[\"Expense Description\"] ||\n    !String(data[\"Expense Description\"]).trim()\n  ) {\n    errors.push(\"Expense description is missing\");\n  }\n\n  // Check receipt information\n  if (!data.merchant_name) {\n    errors.push(\"Merchant name is missing\");\n  }\n\n  if (\n    !data.receipt_date ||\n    isNaN(Date.parse(data.receipt_date))\n  ) {\n    errors.push(\"Receipt date is missing or invalid\");\n  }\n\n  if (!data.receipt_number) {\n    errors.push(\"Receipt number is missing\");\n  }\n\n  if (\n    data.total_amount === null ||\n    data.total_amount === undefined ||\n    !Number.isFinite(Number(data.total_amount)) ||\n    Number(data.total_amount) <= 0\n  ) {\n    errors.push(\"Total amount is missing or invalid\");\n  }\n\n  // Check receipt upload\n  if (!data[\"Receipt Upload\"] || data[\"Receipt Upload\"].length === 0) {\n    errors.push(\"Receipt file is missing\");\n  }\n\n  return {\n    json: {\n      ...data,\n      validation_status: errors.length === 0 ? \"Valid\" : \"Invalid\",\n      validation_errors: errors\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
